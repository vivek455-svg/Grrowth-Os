# ─── Required ───────────────────────────────────────────────────────────────
# Postgres connection used by the server (Supabase: use the pooler connection string,
# "Transaction" mode, port 6543). Queries run as the `authenticated` role with RLS.
DATABASE_URL=postgres://growth:growth@localhost:5432/growth_os
# Public URL of the app (used for OAuth redirect URIs).
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM).
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── Auth (production) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Local demo (development only) ─────────────────────────────────────────
# Ignored whenever Supabase is configured. Signs you in as a fixed demo user.
DEMO_MODE=false

# ─── AI (optional) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ─── Integrations (optional) ───────────────────────────────────────────────
# X (OAuth 2.0, confidential client). Callback: ${APP_URL}/api/integrations/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn (Sign In with LinkedIn using OpenID Connect + Share on LinkedIn).
# Callback: ${APP_URL}/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202606
# Google OAuth client with the Gmail API enabled. Callback: ${APP_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prospect discovery search (Brave Search API)
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# ─── Scheduled jobs ─────────────────────────────────────────────────────────
# Enables GET /api/cron/sync (send `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=
